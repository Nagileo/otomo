# 拷进服务器上的 backend/.env。别提交真实密钥。
# 下面示例用 nip.io 免域名方案：把 1.2.3.4 换成你服务器的公网 IP（点换成横线）。

# —— 公网 URL（三选一）——
# ① nip.io 免域名：https://1-2-3-4.nip.io   （Caddy 会自动申请真 HTTPS 证书）
# ② 有域名：https://otomo.example.com
# ③ Cloudflare Quick Tunnel：填 CF 打印的 https://xxx.trycloudflare.com（每次重启会变，OAuth 不稳）
FRONTEND_BASE_URL=https://1-2-3-4.nip.io
CORS_ALLOWED_ORIGINS=https://1-2-3-4.nip.io
BANGUMI_OAUTH_REDIRECT_URI=https://1-2-3-4.nip.io/auth/bangumi/callback
# Bangumi 开发者后台的「回调地址」必须和上面这行完全一致

# —— Bangumi OAuth 应用（bgm.tv/dev/app 注册「生产专用」应用，多用户各自登录用）——
BANGUMI_OAUTH_CLIENT_ID=
BANGUMI_OAUTH_CLIENT_SECRET=
BANGUMI_USER_AGENT=Nagileo/otomo (+https://github.com/Nagileo/otomo)

COOKIE_SECURE=true
CSRF_PROTECTION_ENABLED=true
AUTH_STORE_BACKEND=sqlite
AUTH_STORE_PATH=cache/auth/auth.sqlite3
LTM_STORE_PATH=cache/ltm/ltm.sqlite3
UPLOAD_STORE_PATH=cache/uploads
OBSERVATION_DIR=cache/observations
TRAJECTORY_DIR=cache/trajectories
SESSION_STORE_PATH=cache/sessions.sqlite3
BACKGROUND_RUN_STORE_PATH=cache/background_runs.sqlite3
SHARE_STORE_PATH=cache/share_snapshots.sqlite3
SUBSCRIPTION_STORE_PATH=cache/subscriptions.sqlite3
TODAY_STORE_PATH=cache/today_preferences.sqlite3
RECOMMENDATION_EVENT_STORE_PATH=cache/recommendation_events.sqlite3
RECOMMENDATION_ARTIFACT_CACHE_PATH=cache/recommendation_artifacts.sqlite3
SERIES_OVERRIDES_PATH=cache/series_overrides.json
RECOMMENDATION_REVIEW_CACHE_TTL=604800
# 同一用户+媒介稳定分桶；更换 salt 会导致用户重新分组，生产部署后请保持不变。
RECOMMENDATION_EXPERIMENT_ENABLED=true
RECOMMENDATION_EXPERIMENT_SALT=replace-with-a-stable-private-salt
RECOMMENDATION_EXPERIMENT_TREATMENT_PERCENT=20
WORKSPACE_STORE_PATH=cache/workspace.sqlite3
COMMUNITY_STORE_PATH=cache/community.sqlite3
# 逗号分隔；管理员可进入 /admin，查看推荐质量、任务状态并治理社区
COMMUNITY_ADMIN_USERNAMES=
# 固定的 Fernet key（生成：python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"）
# 换了这个 key，所有用户登录态失效——务必固定并妥善保存
AUTH_ENCRYPTION_KEY=generate-a-fixed-fernet-key-and-keep-it-safe

# 调度器：API 进程一律 false；由 scheduler 服务统一开（见 docker-compose）
SUBSCRIPTION_SCHEDULER_ENABLED=false
SUBSCRIPTION_SCHEDULER_INTERVAL_SECONDS=900
SUBSCRIPTION_SCHEDULER_MAX_CONCURRENCY=4
# SQLite 跨进程租约；心跳必须明显短于租约，stale 用于后台判断 worker 健康。
SUBSCRIPTION_LEASE_SECONDS=3600
SUBSCRIPTION_LEASE_HEARTBEAT_SECONDS=30
SUBSCRIPTION_WORKER_STALE_SECONDS=120
SUBSCRIPTION_FAILURE_BACKOFF_BASE_SECONDS=60
SUBSCRIPTION_FAILURE_BACKOFF_MAX_SECONDS=21600

RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT_PER_MINUTE=10
RATE_LIMIT_CHAT_PER_HOUR=30
CONVERSATION_COMPACTION_THRESHOLD=80
CONVERSATION_COMPACTION_THRESHOLD_CHARS=120000
CONVERSATION_COMPACTION_KEEP_TURNS=8
CONVERSATION_COMPACTION_INPUT_CHARS=16000
CONVERSATION_COMPACTION_SUMMARY_CHARS=5000
RATE_LIMIT_UPLOADS_PER_MINUTE=5
RATE_LIMIT_SHARE_IP_PER_HOUR=60
RATE_LIMIT_SHARE_USER_PER_HOUR=20
ANONYMOUS_SESSION_TURN_LIMIT=8
DAILY_TOKEN_BUDGET_USER=1500000
DAILY_TOKEN_BUDGET_GLOBAL=8000000
QUOTA_STORE_PATH=cache/quota.json

# LLM / VLM（必填，用你的 key）
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash

# —— Discord bot（可选；填了才随 `docker compose --profile discord up -d` 启动）——
# 开发者后台 discord.com/developers 建应用→Bot→复制 token，并开启 MESSAGE CONTENT INTENT
DISCORD_BOT_TOKEN=

# —— Bilibili ASR（可选；默认关闭，不增加核心镜像体积）——
# 启用后还需手动构建/发布 backend-asr 镜像，并用 docker compose --profile asr。
ASR_PROVIDER=off
ASR_WORKER_URL=http://asr:8010
ASR_WORKER_TOKEN=
ASR_WORKER_TIMEOUT=1800
ASR_MODEL=small
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_LANGUAGE=zh
ASR_MAX_VIDEO_SECONDS=1800

NOTIFICATION_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
WEBPUSH_ENABLED=false
# 首次部署后运行 `bash deploy/configure_webpush.sh 你的邮箱@example.com` 自动填写。
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_VAPID_SUBJECT=mailto:admin@example.com
